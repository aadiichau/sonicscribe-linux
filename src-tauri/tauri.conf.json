{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sonicscribe",
  "mainBinaryName": "sonicscribe",
  "version": "2.0.1",
  "identifier": "io.github.aadiichau.sonicscribe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SonicScribe",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#0d0e10",
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "publisher": "Aditya Chauhan",
    "homepage": "https://github.com/aadiichau/sonicscribe-linux",
    "category": "Productivity",
    "shortDescription": "Local speech-to-text with Whisper",
    "longDescription": "SonicScribe transcribes audio and video on your own computer with faster-whisper. GPU accelerated, private, no account and no limits.",
    "copyright": "Copyright (c) 2026 Aditya Chauhan. MIT License.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "python3",
          "python3-venv"
        ],
        "desktopTemplate": "sonicscribe.desktop"
      },
      "rpm": {
        "depends": [
          "python3"
        ],
        "desktopTemplate": "sonicscribe.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
